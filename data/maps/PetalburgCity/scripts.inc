	waitmovement 0
	msgbox PetalburgCity_Text_CantLetYouThrough, MSGBOX_DEFAULT
	closemessage
	applymovement LOCALID_PLAYER, Common_Movement_WalkRight
	waitmovement 0
	releaseall
	end

